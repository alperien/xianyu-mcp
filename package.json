{
  "name": "xianyu-mcp",
  "version": "0.2.0",
  "description": "Read-only Xianyu (Goofish) MCP server that needs no Xianyu account. No cookies, no login, no stored credentials, no write tools.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xianyu-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "mcp",
    "xianyu",
    "goofish",
    "model-context-protocol",
    "scraping",
    "read-only"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alperien/xianyu-mcp"
  },
  "scripts": {
    "start": "node dist/index.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.0"
  }
}
